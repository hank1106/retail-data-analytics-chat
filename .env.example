# Copy this file to `.env` and fill in the values you need.
# Only TEMPLATE mode works with no keys at all (the default).

# Which response generator to use: template | openai | anthropic | ollama
LLM_PROVIDER=template

# OpenAI (used when LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic (used when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Ollama local model (used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Path to the SQLite database file (created automatically on first run)
DATABASE_PATH=data/retail.db

# Optional: path to your own CSV of the Kaggle dataset.
# When set (or when any *.csv is placed in data/), it is loaded instead of
# the built-in synthetic seed data.
DATA_CSV=

# Kaggle dataset slug used by the download helper
KAGGLE_DATASET=fahadrehman07/retail-transaction-dataset

# Optional: point the Streamlit UI at a running API server.
# When empty, the UI talks to the query engine in-process.
BACKEND_URL=
