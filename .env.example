# Copy to .env and fill in only what you need. The app runs offline without keys.
# RETAIL_DB=data/retail.db
# RETAIL_CSV=data/sample_transactions.csv

# Optional LLM providers (first configured wins; omit all for offline templates):
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-haiku-latest
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.1
# LLM_PROVIDER=off   # force template answers even when a key is set
